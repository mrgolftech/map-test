APP_NAME=Wafer Intelligence
APP_VERSION=0.1.0
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/map-test.db
STATIC_DIR=/app/static

# Administrator login. Keep credentials server-side and out of Git.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Random secret with at least 32 characters. Keep stable across restarts/replicas.
ADMIN_SESSION_SECRET=
# Set true when the site is served over HTTPS.
ADMIN_COOKIE_SECURE=false
ADMIN_SESSION_MAX_AGE_SECONDS=43200

# OpenAI-compatible LLM (server-side only; never expose LLM_API_KEY to frontend)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Server-side encryption secret for persisted LLM API keys (at least 24 characters).
# It is no longer entered in the browser. Keep it stable while encrypted settings exist.
LLM_SETTINGS_ADMIN_TOKEN=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8192
