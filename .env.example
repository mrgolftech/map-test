APP_NAME=Wafer Intelligence
APP_VERSION=0.1.0
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/map-test.db
STATIC_DIR=/app/static

# OpenAI-compatible LLM (server-side only; never expose LLM_API_KEY to frontend)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Set a unique, random server-side token (at least 24 characters) to enable web settings.
# Keep this token stable while encrypted settings are in SQLite; never commit its value.
LLM_SETTINGS_ADMIN_TOKEN=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2200
